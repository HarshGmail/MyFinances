#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
BACKEND_ENV="$HERE/backend.env"
MCP_ENV="$HERE/mcp.env"
TUNNEL_ENV="$HERE/.env"
HEALTH_WAIT_SECONDS=300
REQUIRED_BACKEND_KEYS=(MONGO JWT_SECRET ENCRYPTION_KEY)

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
fail() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

compose() {
  if tunnel_configured; then
    docker compose --project-directory "$HERE" -f "$HERE/compose.yml" --profile public "$@"
  else
    docker compose --project-directory "$HERE" -f "$HERE/compose.yml" "$@"
  fi
}

tunnel_configured() {
  [ -f "$TUNNEL_ENV" ] && grep -qE '^CLOUDFLARE_TUNNEL_TOKEN=.+' "$TUNNEL_ENV"
}

require_settings() {
  local key
  [ -f "$BACKEND_ENV" ] || fail "missing $BACKEND_ENV. Copy the backend's Render environment into it (see README.md)"
  [ -f "$MCP_ENV" ] || fail "missing $MCP_ENV (see README.md)"
  for key in "${REQUIRED_BACKEND_KEYS[@]}"; do
    grep -qE "^$key=.+" "$BACKEND_ENV" || fail "$key is empty in $BACKEND_ENV"
  done
  chmod 600 "$BACKEND_ENV" "$MCP_ENV"
  [ ! -f "$TUNNEL_ENV" ] || chmod 600 "$TUNNEL_ENV"
}

wait_until_healthy() {
  local waited=0
  say "waiting for the backend"
  until docker inspect -f '{{.State.Health.Status}}' myfinances-backend 2>/dev/null | grep -qx healthy; do
    [ "$waited" -lt "$HEALTH_WAIT_SECONDS" ] || fail "backend not healthy after ${HEALTH_WAIT_SECONDS}s. See: ./myfinances logs backend"
    sleep 5
    waited=$((waited + 5))
  done
  say "MyFinances is up$(tunnel_configured && echo ', public through the Cloudflare tunnel' || echo ' (local only: no tunnel token yet)')"
}

cmd_up() {
  require_settings
  compose up -d --build --remove-orphans
  wait_until_healthy
}

cmd_deploy() {
  say "pulling the latest main"
  git -C "$REPO" pull --ff-only
  cmd_up
  docker image prune -f >/dev/null
}

cmd_status() {
  compose ps --format 'table {{.Service}}\t{{.Status}}'
  printf '\nbackend: %s\n' "$(curl -s --max-time 5 http://127.0.0.1:5000/api/health || echo unreachable)"
}

cmd_help() {
  cat <<EOF
usage: deploy/home/myfinances <command>

  up       build and start (backend, MCP, PDF parsing, and the tunnel once configured)
  deploy   git pull, then up
  down     stop
  status   what is running
  logs     follow logs (add a service: backend, mcp, pdf-parsing, tunnel)
EOF
}

main() {
  case "${1:-help}" in
    up) cmd_up ;;
    deploy) cmd_deploy ;;
    down) compose down ;;
    status) cmd_status ;;
    logs) shift; compose logs -f --tail=100 "$@" ;;
    help | -h | --help) cmd_help ;;
    *) cmd_help; exit 1 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
