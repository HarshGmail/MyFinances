#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
BACKEND_ENV="$HERE/backend.env"
MCP_ENV="$HERE/mcp.env"
TUNNEL_ENV="$HERE/.env"
HEALTH_WAIT_SECONDS=300
REQUIRED_BACKEND_KEYS=(MONGO JWT_SECRET ENCRYPTION_KEY)
SERVER_PATHS=(backend mcp-server pdf-parsing deploy/home)
GITHUB_API="https://api.github.com/repos/HarshGmail/MyFinances"
AUTO_DEPLOY_UNIT="myfinances-auto-deploy"
LAST_REFUSED_FILE="$HERE/.last-refused-commit"
GITHUB_ENV_FILE="$HERE/github.env"
STATUS_CONTEXT="deploy / pingu"
SITE_HEALTH_URL="https://api.my-finances.site/api/health"

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
fail() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

compose() {
  if tunnel_configured; then
    docker compose --project-directory "$HERE" -f "$HERE/compose.yml" --profile public "$@"
  else
    docker compose --project-directory "$HERE" -f "$HERE/compose.yml" "$@"
  fi
}

tunnel_configured() {
  [ -f "$TUNNEL_ENV" ] && grep -qE '^CLOUDFLARE_TUNNEL_TOKEN=.+' "$TUNNEL_ENV"
}

require_settings() {
  local key
  [ -f "$BACKEND_ENV" ] || fail "missing $BACKEND_ENV. Copy the backend's Render environment into it (see README.md)"
  [ -f "$MCP_ENV" ] || fail "missing $MCP_ENV (see README.md)"
  for key in "${REQUIRED_BACKEND_KEYS[@]}"; do
    grep -qE "^$key=.+" "$BACKEND_ENV" || fail "$key is empty in $BACKEND_ENV"
  done
  chmod 600 "$BACKEND_ENV" "$MCP_ENV"
  [ ! -f "$TUNNEL_ENV" ] || chmod 600 "$TUNNEL_ENV"
}

wait_until_healthy() {
  local waited=0
  say "waiting for the backend"
  until docker inspect -f '{{.State.Health.Status}}' myfinances-backend 2>/dev/null | grep -qx healthy; do
    [ "$waited" -lt "$HEALTH_WAIT_SECONDS" ] || fail "backend not healthy after ${HEALTH_WAIT_SECONDS}s. See: ./myfinances logs backend"
    sleep 5
    waited=$((waited + 5))
  done
  say "MyFinances is up$(tunnel_configured && echo ', public through the Cloudflare tunnel' || echo ' (local only: no tunnel token yet)')"
}

cmd_up() {
  require_settings
  compose up -d --build --remove-orphans
  wait_until_healthy
}

cmd_deploy() {
  say "pulling the latest main"
  git -C "$REPO" pull --ff-only
  cmd_up
  docker image prune -f >/dev/null
}

changed_server_paths() {
  git -C "$REPO" diff --name-only "$1" "$2" -- "${SERVER_PATHS[@]}"
}

ci_runs_for() {
  local response
  response="$(curl -fsS --max-time 20 "$GITHUB_API/actions/runs?head_sha=$1&event=push&per_page=50" 2>/dev/null)" ||
    return 1
  printf '%s' "$response" | python3 -c '
import json, sys
for run in json.load(sys.stdin)["workflow_runs"]:
    print(run["path"], run["status"], run["conclusion"] or "-")
'
}

CHECKED_PARTS=(
  "backend .github/workflows/backend.yml"
  "mcp-server .github/workflows/mcp.yml"
  "pdf-parsing .github/workflows/pdf-parsing.yml"
)

last_commit_touching() {
  git -C "$REPO" log -1 --format=%H "$1..$2" -- "$3"
}

ci_state() {
  local sha="$1" workflow="$2" runs
  runs="$(ci_runs_for "$sha")" || { echo unknown; return; }
  printf '%s\n' "$runs" | awk -v w="$workflow" '$1 == w {print $2 " " $3; found = 1; exit} END {if (!found) print "missing"}'
}

ci_verdict() {
  local running="$1" latest="$2" part folder workflow sha state
  for part in "${CHECKED_PARTS[@]}"; do
    read -r folder workflow <<<"$part"
    sha="$(last_commit_touching "$running" "$latest" "$folder")"
    [ -n "$sha" ] || continue
    state="$(ci_state "$sha" "$workflow")"
    case "$state" in
      "completed success") ;;
      "completed "*) echo "failed:$workflow"; return ;;
      *) echo waiting; return ;;
    esac
  done
  echo passed
}

status_token() {
  [ -f "$GITHUB_ENV_FILE" ] || return 0
  sed -nE 's/^GITHUB_STATUS_TOKEN=(.+)$/\1/p' "$GITHUB_ENV_FILE" | tail -n 1
}

report_to_github() {
  local sha="$1" state="$2" description="$3" token
  token="$(status_token)"
  [ -n "$token" ] || return 0
  curl -fsS --max-time 20 -o /dev/null -X POST "$GITHUB_API/statuses/$sha" \
    -H "Authorization: Bearer $token" -H "Accept: application/vnd.github+json" \
    -d "{\"state\":\"$state\",\"context\":\"$STATUS_CONTEXT\",\"description\":\"$description\",\"target_url\":\"$SITE_HEALTH_URL\"}" ||
    echo "could not report '$state' to GitHub" >&2
}

deploy_verified_commit() {
  local running="$1" latest="$2"
  say "deploying ${latest:0:7}: CI passed"
  report_to_github "$latest" pending "Deploying to pingu"
  git -C "$REPO" merge -q --ff-only "$latest"
  if "$HERE/myfinances" up; then
    docker image prune -f >/dev/null
    report_to_github "$latest" success "Live on pingu"
    say "deployed ${latest:0:7}"
  else
    report_to_github "$latest" failure "Deploy failed on pingu; see: myfinances history"
    say "deploy of ${latest:0:7} failed"
  fi
}

cmd_auto_deploy() {
  local running latest changed verdict
  git -C "$REPO" fetch -q origin main
  running="$(git -C "$REPO" rev-parse HEAD)"
  latest="$(git -C "$REPO" rev-parse origin/main)"
  [ "$running" != "$latest" ] || return 0
  changed="$(changed_server_paths "$running" "$latest")"
  if [ -z "$changed" ]; then
    git -C "$REPO" merge -q --ff-only origin/main
    say "main moved to ${latest:0:7}; nothing for the server changed"
    return 0
  fi
  verdict="$(ci_verdict "$running" "$latest")"
  case "$verdict" in
    passed) deploy_verified_commit "$running" "$latest" ;;
    waiting) ;;
    failed:*)
      [ "$(cat "$LAST_REFUSED_FILE" 2>/dev/null)" = "$latest" ] && return 0
      say "not deploying ${latest:0:7}: ${verdict#failed:} failed. pingu stays on ${running:0:7}"
      report_to_github "$latest" error "Not deployed: CI failed. pingu stays on ${running:0:7}"
      echo "$latest" >"$LAST_REFUSED_FILE"
      ;;
  esac
}

install_auto_deploy() {
  local unit_dir="/etc/systemd/system"
  say "checking GitHub every 5 minutes for merges to main (asks for your password once)"
  sudo tee "$unit_dir/$AUTO_DEPLOY_UNIT.service" >/dev/null <<EOF
[Unit]
Description=Deploy MyFinances when main has new commits that passed CI
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=$(id -un)
ExecStart=$HERE/myfinances auto-deploy
EOF
  sudo tee "$unit_dir/$AUTO_DEPLOY_UNIT.timer" >/dev/null <<EOF
[Unit]
Description=Check for MyFinances merges every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable --now "$AUTO_DEPLOY_UNIT.timer"
  say "on. History: deploy/home/myfinances history"
}

cmd_status() {
  compose ps --format 'table {{.Service}}\t{{.Status}}'
  printf '\nbackend: %s\n' "$(curl -s --max-time 5 http://127.0.0.1:5000/api/health || echo unreachable)"
}

cmd_help() {
  cat <<EOF
usage: deploy/home/myfinances <command>

  up       build and start (backend, MCP, PDF parsing, and the tunnel once configured)
  deploy        git pull, then up
  auto-deploy   deploy if main has new server changes whose CI passed
  install-auto-deploy   run auto-deploy every 5 minutes
  history       what auto-deploy did recently
  down          stop
  status        what is running
  logs          follow logs (add a service: backend, mcp, pdf-parsing, tunnel)
EOF
}

main() {
  case "${1:-help}" in
    up) cmd_up ;;
    deploy) cmd_deploy ;;
    auto-deploy) cmd_auto_deploy ;;
    install-auto-deploy) install_auto_deploy ;;
    history) journalctl -u "$AUTO_DEPLOY_UNIT" --no-pager -n 40 -o cat | grep -v -e '^Started ' -e '^Finished ' -e 'Deactivated successfully' ;;
    down) compose down ;;
    status) cmd_status ;;
    logs) shift; compose logs -f --tail=100 "$@" ;;
    help | -h | --help) cmd_help ;;
    *) cmd_help; exit 1 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
